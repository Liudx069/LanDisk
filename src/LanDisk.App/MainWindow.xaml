<ui:FluentWindow x:Class="LanDisk.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
                 Title="LanDisk"
                 Width="1160" Height="780"
                 MinWidth="640" MinHeight="400"
                 WindowStartupLocation="CenterScreen"
                 WindowState="Maximized"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource LanDisk.Window}"
                 Foreground="{DynamicResource LanDisk.TextPrimary}"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 FontSize="14">

  <!-- Explicit window-coloured background on the root: FluentWindow's own template paints a light
       content presenter, and on Windows 10 there is no Mica to fall back on, so the surface has to be
       stated rather than inherited. -->
  <Grid Background="{DynamicResource LanDisk.Window}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="LanDisk" ShowMaximize="True" ShowMinimize="True" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="RailColumn" Width="228" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!--
        A left rail built from plain buttons rather than NavigationView: the pages here are ordinary
        WPF panels whose contents come from the running server, so a frame-based navigation control
        would add indirection without adding anything the user can see. The visual language is the
        same Fluent rail, and every item is a real focusable button so keyboard navigation works.
      -->
      <Border Grid.Column="0"
              Background="{DynamicResource LanDisk.Surface}"
              BorderThickness="0,0,1,0"
              BorderBrush="{DynamicResource LanDisk.Secondary}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="NavList" Margin="8,8,8,12" />
        </ScrollViewer>
      </Border>

      <ScrollViewer Grid.Column="1"
                    Background="{DynamicResource LanDisk.Window}"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="20,10,20,18">
        <StackPanel x:Name="ContentHost" />
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource LanDisk.Surface}"
            Padding="16,8"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource LanDisk.Secondary}">
      <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,8,0"
                 VerticalAlignment="Center" Fill="{DynamicResource LanDisk.Warning}" />
        <TextBlock x:Name="StatusText" FontSize="12.5" VerticalAlignment="Center"
                   Foreground="{DynamicResource LanDisk.TextSecondary}" Text="正在启动…" />
      </StackPanel>
    </Border>

    <!-- The tray icon lives in the visual tree, so its lifetime is the window's lifetime. -->
    <tray:NotifyIcon x:Name="Tray" TooltipText="LanDisk" Grid.Row="0" Visibility="Collapsed">
      <tray:NotifyIcon.Menu>
        <ContextMenu>
          <MenuItem x:Name="TrayOpen" Header="打开 LanDisk" />
          <MenuItem x:Name="TrayIphone" Header="连接 iPhone" />
          <Separator />
          <MenuItem x:Name="TrayRestart" Header="重新启动服务" />
          <Separator />
          <MenuItem x:Name="TrayExit" Header="退出 LanDisk" />
        </ContextMenu>
      </tray:NotifyIcon.Menu>
    </tray:NotifyIcon>
  </Grid>
</ui:FluentWindow>
