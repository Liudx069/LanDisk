<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Fluent Obsidian.

    A dark technical palette with a small amount of cyan and blue, plus a light variant that is
    derived from the same names so nothing has to be re-specified per theme. The dark values are the
    design system's; the light values are the same hues at usable contrast, because a product that
    only looks right in dark mode is a product that looks broken on a bright office PC.

    Windows 10 has no Mica, so the window background is a solid brush rather than a material. The
    application never assumes a backdrop exists.
  -->

  <!-- Dark (default) -->
  <Color x:Key="LanDisk.WindowColor">#FF0B0F14</Color>
  <Color x:Key="LanDisk.NavigationColor">#FF0E141C</Color>
  <Color x:Key="LanDisk.SurfaceColor">#FF111821</Color>
  <Color x:Key="LanDisk.SecondaryColor">#FF16202B</Color>
  <Color x:Key="LanDisk.ElevatedColor">#FF182432</Color>
  <Color x:Key="LanDisk.OverlayColor">#FF1B2735</Color>
  <Color x:Key="LanDisk.TextPrimaryColor">#FFF5F7FA</Color>
  <Color x:Key="LanDisk.TextSecondaryColor">#FFAAB6C5</Color>
  <Color x:Key="LanDisk.TextTertiaryColor">#FF8894A3</Color>
  <Color x:Key="LanDisk.TextDisabledColor">#FF5E6A78</Color>
  <Color x:Key="LanDisk.BorderColor">#FF233041</Color>
  <Color x:Key="LanDisk.BorderStrongColor">#FF33455C</Color>
  <Color x:Key="LanDisk.ControlColor">#FF1B2634</Color>
  <Color x:Key="LanDisk.ControlHoverColor">#FF22303F</Color>
  <Color x:Key="LanDisk.ControlPressedColor">#FF17212D</Color>
  <Color x:Key="LanDisk.SelectionColor">#FF1E3A52</Color>
  <Color x:Key="LanDisk.AccentCyanColor">#FF45C8FF</Color>
  <Color x:Key="LanDisk.AccentBlueColor">#FF5A8CFF</Color>
  <Color x:Key="LanDisk.AccentHoverColor">#FF69D4FF</Color>
  <Color x:Key="LanDisk.AccentPressedColor">#FF2FB0E6</Color>
  <Color x:Key="LanDisk.SuccessColor">#FF47D18C</Color>
  <Color x:Key="LanDisk.WarningColor">#FFFFBE55</Color>
  <Color x:Key="LanDisk.ErrorColor">#FFFF6677</Color>
  <Color x:Key="LanDisk.InfoColor">#FF6FB4FF</Color>

  <SolidColorBrush x:Key="LanDisk.Window" Color="{StaticResource LanDisk.WindowColor}" />
  <SolidColorBrush x:Key="LanDisk.Navigation" Color="{StaticResource LanDisk.NavigationColor}" />
  <SolidColorBrush x:Key="LanDisk.Surface" Color="{StaticResource LanDisk.SurfaceColor}" />
  <SolidColorBrush x:Key="LanDisk.Secondary" Color="{StaticResource LanDisk.SecondaryColor}" />
  <SolidColorBrush x:Key="LanDisk.Elevated" Color="{StaticResource LanDisk.ElevatedColor}" />
  <SolidColorBrush x:Key="LanDisk.Overlay" Color="{StaticResource LanDisk.OverlayColor}" />
  <SolidColorBrush x:Key="LanDisk.TextPrimary" Color="{StaticResource LanDisk.TextPrimaryColor}" />
  <SolidColorBrush x:Key="LanDisk.TextSecondary" Color="{StaticResource LanDisk.TextSecondaryColor}" />
  <SolidColorBrush x:Key="LanDisk.TextTertiary" Color="{StaticResource LanDisk.TextTertiaryColor}" />
  <SolidColorBrush x:Key="LanDisk.TextDisabled" Color="{StaticResource LanDisk.TextDisabledColor}" />
  <SolidColorBrush x:Key="LanDisk.Border" Color="{StaticResource LanDisk.BorderColor}" />
  <SolidColorBrush x:Key="LanDisk.BorderStrong" Color="{StaticResource LanDisk.BorderStrongColor}" />
  <SolidColorBrush x:Key="LanDisk.Control" Color="{StaticResource LanDisk.ControlColor}" />
  <SolidColorBrush x:Key="LanDisk.ControlHover" Color="{StaticResource LanDisk.ControlHoverColor}" />
  <SolidColorBrush x:Key="LanDisk.ControlPressed" Color="{StaticResource LanDisk.ControlPressedColor}" />
  <SolidColorBrush x:Key="LanDisk.Selection" Color="{StaticResource LanDisk.SelectionColor}" />
  <SolidColorBrush x:Key="LanDisk.AccentCyan" Color="{StaticResource LanDisk.AccentCyanColor}" />
  <SolidColorBrush x:Key="LanDisk.AccentBlue" Color="{StaticResource LanDisk.AccentBlueColor}" />
  <SolidColorBrush x:Key="LanDisk.AccentHover" Color="{StaticResource LanDisk.AccentHoverColor}" />
  <SolidColorBrush x:Key="LanDisk.AccentPressed" Color="{StaticResource LanDisk.AccentPressedColor}" />
  <SolidColorBrush x:Key="LanDisk.Success" Color="{StaticResource LanDisk.SuccessColor}" />
  <SolidColorBrush x:Key="LanDisk.Warning" Color="{StaticResource LanDisk.WarningColor}" />
  <SolidColorBrush x:Key="LanDisk.Error" Color="{StaticResource LanDisk.ErrorColor}" />
  <SolidColorBrush x:Key="LanDisk.Info" Color="{StaticResource LanDisk.InfoColor}" />

  <Style x:Key="LanDisk.PrimaryButton" TargetType="Button">
    <Setter Property="Foreground" Value="#FF06121C" />
    <Setter Property="Background" Value="{StaticResource LanDisk.AccentCyan}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LanDisk.Page" TargetType="ContentControl">
    <Setter Property="Foreground" Value="{StaticResource LanDisk.TextPrimary}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

</ResourceDictionary>
