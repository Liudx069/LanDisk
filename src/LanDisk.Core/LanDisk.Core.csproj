<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>LanDisk.Core</RootNamespace>
    <AssemblyName>LanDisk.Core</AssemblyName>
    <Version>1.8.1</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project drives the mDNS responder's interface-selection seam (UseSockets/SendUnicast),
         because proving "the reply left through the socket the question arrived on" needs two
         interfaces and the build machine has one. Nothing here is part of the public surface. -->
    <InternalsVisibleTo Include="LanDisk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows only image pipeline used exclusively to build small listing thumbnails.
         MIT licensed, ships as part of the self contained runtime. The source image is opened
         through the same verified file handle as every other read path. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>

</Project>
