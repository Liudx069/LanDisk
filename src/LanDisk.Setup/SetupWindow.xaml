<Window x:Class="LanDisk.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:visual="clr-namespace:LanDisk.Setup.Visual"
        Title="安装 LanDisk"
        Width="660" Height="900"
        MinWidth="600" MinHeight="780"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        SnapsToDevicePixels="True">

    <!-- The install window is a single dark surface with custom chrome. There is deliberately no title bar,
         no step strip, no numbered nodes, no progress bar and no card framing the picture: the rack powering
         on is the progress. -->
    <Border x:Name="Shell"
            CornerRadius="16"
            Background="{x:Static visual:SetupVisualTheme.WindowBrush}"
            BorderBrush="{x:Static visual:SetupVisualTheme.FrameEdgeBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Chrome: a quiet title on the left, close on the right; the whole strip is draggable. -->
            <Grid Grid.Row="0" x:Name="TitleBar" Height="44" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <TextBlock x:Name="ChromeTitle"
                           Text="安装 LanDisk"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12.5"
                           FontFamily="{x:Static visual:SetupVisualTheme.FontStack}"
                           Foreground="{x:Static visual:SetupVisualTheme.TextTertiaryBrush}" />
                <Button x:Name="CloseButton"
                        Content="✕"
                        Width="34" Height="30"
                        HorizontalAlignment="Right"
                        Margin="0,0,10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{x:Static visual:SetupVisualTheme.TextTertiaryBrush}"
                        FontSize="12"
                        Click="OnCloseClick" />
            </Grid>

            <Grid Grid.Row="1" Margin="24,0,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand mark: transparent vector geometry, horizontally centred, with real breathing room
                     above the cabinet (never touching it). -->
                <Viewbox Grid.Row="0" x:Name="LogoBox" Height="44" HorizontalAlignment="Center" Stretch="Uniform" />


                <!-- The rack. Everything above the fold exists to give this room. -->
                <Viewbox Grid.Row="2" x:Name="RackBox" Margin="0,34,0,14" Stretch="Uniform">
                    <visual:RackVisual x:Name="Rack" />
                </Viewbox>

                <!-- One line of state. Never the whole task list. -->
                <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                    <TextBlock x:Name="StateTitle"
                               HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               FontFamily="{x:Static visual:SetupVisualTheme.FontStack}"
                               Foreground="{x:Static visual:SetupVisualTheme.TextPrimaryBrush}"
                               Text="准备安装" />
                    <TextBlock x:Name="StateDetail"
                               Margin="0,6,0,0"
                               MaxWidth="520"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="12.5"
                               FontFamily="{x:Static visual:SetupVisualTheme.FontStack}"
                               Foreground="{x:Static visual:SetupVisualTheme.TextSecondaryBrush}"
                               Text="点击开始；安装过程中不需要其它选择。" />
                </StackPanel>

                <!-- Intro options and the single primary action. -->
                <StackPanel Grid.Row="4" x:Name="IntroPanel" Margin="0,22,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <CheckBox x:Name="DesktopShortcut" Content="创建桌面快捷方式" IsChecked="True"
                                  Foreground="{x:Static visual:SetupVisualTheme.TextSecondaryBrush}"
                                  FontFamily="{x:Static visual:SetupVisualTheme.FontStack}" FontSize="12.5" Margin="0,0,18,0" />
                        <CheckBox x:Name="LaunchAfter" Content="安装后启动 LanDisk" IsChecked="True"
                                  Foreground="{x:Static visual:SetupVisualTheme.TextSecondaryBrush}"
                                  FontFamily="{x:Static visual:SetupVisualTheme.FontStack}" FontSize="12.5" />
                    </StackPanel>
                    <Button x:Name="InstallButton" Content="安装" Width="180" Height="38" Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            Click="OnInstallClick"
                            Background="{x:Static visual:SetupVisualTheme.AccentBrush}"
                            Foreground="#08121B" BorderThickness="0" FontSize="13.5" FontWeight="SemiBold"
                            FontFamily="{x:Static visual:SetupVisualTheme.FontStack}" />
                </StackPanel>
            </Grid>

            <!-- The only secondary control: installation details, collapsed by default. -->
            <StackPanel Grid.Row="2" x:Name="DetailPanel" Margin="24,0,24,16">
                <Button x:Name="DetailToggle" Content="显示安装详情"
                        HorizontalAlignment="Center" Height="26" Padding="12,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{x:Static visual:SetupVisualTheme.TextTertiaryBrush}"
                        FontSize="11.5" FontFamily="{x:Static visual:SetupVisualTheme.FontStack}"
                        Click="OnDetailToggle" />
                <Border x:Name="DetailSurface" Visibility="Collapsed" Height="150" Margin="0,10,0,0"
                        CornerRadius="8" Background="{x:Static visual:SetupVisualTheme.WindowElevatedBrush}"
                        BorderBrush="{x:Static visual:SetupVisualTheme.FrameEdgeBrush}" BorderThickness="1">
                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Padding="12,10">
                        <TextBlock x:Name="DetailText" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11.5"
                                   Foreground="{x:Static visual:SetupVisualTheme.TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
